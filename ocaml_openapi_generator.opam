opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/public-release-reloaded/ocaml_openapi_generator"
bug-reports: "https://github.com/public-release-reloaded/ocaml_openapi_generator/issues"
dev-repo: "git+https://github.com/public-release-reloaded/ocaml_openapi_generator.git#v0.18_preview.130.100+614+reloaded"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/ocaml_openapi_generator/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.5.0"}
  "async" {>= "v0.18~" & < "v0.19~"}
  "async_interactive" {>= "v0.18~" & < "v0.19~"}
  "base" {>= "v0.18~" & < "v0.19~"}
  "capitalization" {>= "v0.18~" & < "v0.19~"}
  "core" {>= "v0.18~" & < "v0.19~"}
  "core_kernel" {>= "v0.18~" & < "v0.19~"}
  "core_unix" {>= "v0.18~" & < "v0.19~"}
  "file_path" {>= "v0.18~" & < "v0.19~"}
  "jsonaf" {>= "v0.18~" & < "v0.19~"}
  "ocaml-embed-file" {>= "v0.18~" & < "v0.19~"}
  "ppx_derive_at_runtime" {>= "v0.18~" & < "v0.19~"}
  "ppx_jane" {>= "v0.18~" & < "v0.19~"}
  "ppx_jsonaf_conv" {>= "v0.18~" & < "v0.19~"}
  "roundtrippable_command_param" {>= "v0.18~" & < "v0.19~"}
  "dune" {>= "3.17.0"}
  "httpaf" {>= "0.7.1"}
  "jingoo" {>= "1.4.4" & < "1.5.0"}
  "uri" {>= "4.4.0"}
]
available: arch != "x86_32"
synopsis: "An OpenAPI 3 to OCaml client generator."
description: "
An OpenAPI 3 to OCaml client generator.
"
